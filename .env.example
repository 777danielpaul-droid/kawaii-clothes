# Shopify Storefront API (öffentlicher Token, landet im Browser)
VITE_SHOPIFY_DOMAIN=dein-shop.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
VITE_SHOPIFY_API_VERSION=2024-04

# CMS-Server (nur auf dem Server, ohne VITE_-Präfix, wird nie an den Browser ausgeliefert)
# ADMIN_PASSWORD wird beim ersten Start automatisch erzeugt und hier eingetragen (npm run setup).
# ADMIN_PASSWORD=
# PORT=3001
# HOST=127.0.0.1       (auf einem Server 0.0.0.0 setzen)
# DATA_DIR=data
# SESSION_SECRET=      (leer = wird einmalig erzeugt und in data/.secret abgelegt)
# TRUST_PROXY=1        (nur setzen, wenn der Server hinter einem Proxy mit HTTPS läuft)
