  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@fontsource/edu-qld-beginner": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "locomotive-scroll": "^5.0.1",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=20"
  }
}
